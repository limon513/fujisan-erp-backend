{
  "name": "fujisan-erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Real-estate ERP backend (Express + Prisma + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#core/*": "./src/core/*",
    "#modules/*": "./src/modules/*",
    "#generated/*": "./src/generated/*"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:module": "node scripts/make-module.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:format": "prisma format",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:new-migration": "node scripts/new-migration.js",
    "build": "prisma generate",
    "start:prod": "prisma migrate deploy && node prisma/seed/index.js && node src/index.js",
    "postinstall": "prisma generate"
  },
  "author": "Limon",
  "license": "UNLICENSED",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vitest": "5.0.3"
  }
}
