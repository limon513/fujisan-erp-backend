NODE_ENV=development
PORT=4000
APP_NAME="Fujisan ERP"

# PostgreSQL. On Neon: DATABASE_URL = pooled URL (host contains "-pooler"),
# DIRECT_DATABASE_URL = direct URL (used only for migrations). Locally leave DIRECT empty.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fujisan_erp
DIRECT_DATABASE_URL=

# Proxies in front of the API: 1 behind Nginx, 2 behind Vercel rewrite + Render
TRUST_PROXY=1

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Comma separated module names, or "*" for all registered modules
ENABLED_MODULES=*

# Swagger UI at /api/docs (keep false in production unless protected)
API_DOCS_ENABLED=true

LOG_LEVEL=info

# Seed (npm run db:seed)
SEED_CLIENT=fujisan
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=
# Leave empty to generate a strong password (printed once)
SEED_ADMIN_PASSWORD=

# Separate database used by `npm test`
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fujisan_erp_test

# Auth — generate with: node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Mail — RESEND_API_KEY (HTTP API, preferred) or SMTP_HOST; with neither, emails are printed to the log.
# Resend without a verified domain: MAIL_FROM must be "<name> <onboarding@resend.dev>" and mail only
# reaches the Resend account owner's address.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fujisan ERP <no-reply@fujisan.example>"

# File storage: local disk for development; "s3" for hosted (Neon storage / Cloudflare R2 / AWS S3).
# S3_* may also be given with the standard AWS_* names (AWS_ENDPOINT_URL_S3, AWS_REGION, ...).
# Render's disk is wiped on every deploy, so hosted environments must use s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10
