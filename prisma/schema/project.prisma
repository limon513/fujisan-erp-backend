// Real-estate core: projects → blocks / roads → plots, with hold, status and price history.

enum ProjectStatus {
  PLANNING
  ONGOING
  COMPLETED
  ON_HOLD
}

model Project {
  id                   String        @id @default(uuid(7)) @db.Uuid
  code                 String        @unique
  name                 String
  status               ProjectStatus @default(ONGOING)
  description          String?
  address              String?
  district             String?
  upazila              String?
  latitude             Decimal?      @db.Decimal(9, 6)
  longitude            Decimal?      @db.Decimal(9, 6)
  /// total land of the project, in decimal (শতাংশ)
  landAreaDecimal      Decimal?      @db.Decimal(12, 2)
  launchDate           DateTime?     @db.Date
  expectedHandoverDate DateTime?     @db.Date
  branchId             String?       @db.Uuid
  projectManagerId     String?       @db.Uuid
  /// master-plan image; its pixel size is the plot map's coordinate space
  layoutFileId         String?       @db.Uuid
  layoutWidth          Int?
  layoutHeight         Int?
  /// default length of a plot hold, in days
  defaultHoldDays      Int           @default(7)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  createdById          String?       @db.Uuid
  updatedById          String?       @db.Uuid
  deletedAt            DateTime?     @db.Timestamptz(3)

  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  projectManager  Employee?            @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  layoutFile      File?                @relation("ProjectLayout", fields: [layoutFileId], references: [id], onDelete: SetNull)
  blocks          Block[]
  roads           Road[]
  plots           Plot[]
  interestedLeads Lead[]               @relation("LeadPreferredProject")
  siteVisits      SiteVisit[]          @relation("SiteVisitProject")
  assignmentRules LeadAssignmentRule[] @relation("AssignmentRuleProject")
  paymentPlans    PaymentPlan[]        @relation("ProjectPaymentPlans")
  bookings        Booking[]            @relation("ProjectBookings")
  costs           ProjectCost[]        @relation("ProjectCosts")
}

model Block {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @db.Uuid
  code        String
  name        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plots   Plot[]

  @@unique([projectId, code])
}

model Road {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  widthFeet   Decimal? @db.Decimal(6, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plots   Plot[]

  @@unique([projectId, name])
}

enum PlotStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
  BLOCKED
}

enum Facing {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

model Plot {
  id              String     @id @default(uuid(7)) @db.Uuid
  projectId       String     @db.Uuid
  blockId         String     @db.Uuid
  roadId          String?    @db.Uuid
  plotNumber      String
  /// "<block code>-<plot number>", unique per project (e.g. A-102)
  code            String
  areaSqft        Decimal    @db.Decimal(12, 2)
  /// e.g. "40 × 60 ft"
  dimensions      String?
  facing          Facing?
  /// price of this plot (set per plot; no premiums)
  price           Decimal    @db.Decimal(14, 2)
  status          PlotStatus @default(AVAILABLE)
  statusChangedAt DateTime   @default(now()) @db.Timestamptz(3)
  /// polygon on the layout image: { points: [[x, y], ...] } in image pixels
  mapShape        Json?
  /// label position on the layout image: { x, y }
  mapLabel        Json?
  remarks         String?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  createdById     String?    @db.Uuid
  updatedById     String?    @db.Uuid
  deletedAt       DateTime?  @db.Timestamptz(3)

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  block         Block               @relation(fields: [blockId], references: [id], onDelete: Restrict)
  road          Road?               @relation(fields: [roadId], references: [id], onDelete: SetNull)
  holds         PlotHold[]
  statusHistory PlotStatusHistory[]
  priceHistory  PlotPriceHistory[]
  bookings      Booking[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([blockId])
}

enum PlotHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED
}

/// Every hold ever placed on a plot. At most one ACTIVE per plot (partial unique index in SQL).
model PlotHold {
  id             String         @id @default(uuid(7)) @db.Uuid
  plotId         String         @db.Uuid
  /// employee who asked for the hold (e.g. the sales executive with the customer)
  requestedById  String         @db.Uuid
  /// user who placed it (Sales Manager and above)
  heldById       String         @db.Uuid
  customerId     String?        @db.Uuid
  /// prospect details when they aren't a customer yet
  prospectName   String?
  prospectMobile String?
  reason         String
  days           Int
  expiresAt      DateTime       @db.Timestamptz(3)
  status         PlotHoldStatus @default(ACTIVE)
  releasedAt     DateTime?      @db.Timestamptz(3)
  releasedById   String?        @db.Uuid
  releaseReason  String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  plot        Plot      @relation(fields: [plotId], references: [id], onDelete: Restrict)
  requestedBy Employee  @relation("PlotHoldRequests", fields: [requestedById], references: [id], onDelete: Restrict)
  heldBy      User      @relation("PlotHoldsPlaced", fields: [heldById], references: [id], onDelete: Restrict)
  releasedBy  User?     @relation("PlotHoldsReleased", fields: [releasedById], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([plotId, createdAt])
  @@index([status, expiresAt])
}

model PlotStatusHistory {
  id          String      @id @default(uuid(7)) @db.Uuid
  plotId      String      @db.Uuid
  fromStatus  PlotStatus?
  toStatus    PlotStatus
  /// HOLD, RELEASE, EXPIRY, BLOCK, UNBLOCK, BOOKING, REGISTRATION, CANCELLATION, CREATE
  refType     String
  refId       String?
  reason      String?
  /// null = system (e.g. hold expiry job)
  changedById String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId, createdAt])
}

model PlotPriceHistory {
  id          String   @id @default(uuid(7)) @db.Uuid
  plotId      String   @db.Uuid
  oldPrice    Decimal? @db.Decimal(14, 2)
  newPrice    Decimal  @db.Decimal(14, 2)
  reason      String?
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId, createdAt])
}
