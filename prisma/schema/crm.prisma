// CRM: lead sources, campaigns, leads and their activity timeline.

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  SITE_VISIT
  NEGOTIATION
  BOOKING
  CONVERTED
  LOST
}

enum LeadActivityType {
  CREATED
  NOTE
  CALL
  SMS
  WHATSAPP
  EMAIL
  MEETING
  STATUS_CHANGE
  ASSIGNMENT
  CONVERTED
  FOLLOW_UP_SCHEDULED
  SITE_VISIT_SCHEDULED
  SITE_VISIT
}

enum FollowUpType {
  CALL
  WHATSAPP
  SMS
  EMAIL
  MEETING
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

enum SiteVisitStatus {
  SCHEDULED
  VISITED
  NO_SHOW
  CANCELLED
}

enum SiteVisitTransport {
  OFFICE_CAR
  OWN
  OTHER
}

enum InterestLevel {
  HOT
  WARM
  COLD
}

/// Facebook, Website, Walk-in, Referral, ... (editable list; `code` identifies seeded ones)
model LeadSource {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String   @unique
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  campaigns       Campaign[]
  leads           Lead[]
  assignmentRules LeadAssignmentRule[]
}

model Campaign {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  sourceId    String?   @db.Uuid
  budget      Decimal?  @db.Decimal(14, 2)
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  /// e.g. the Facebook campaign id, for lead-ad imports (Phase 5)
  externalId  String?   @unique
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(3)

  source LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  leads  Lead[]
}

model Lead {
  id                  String     @id @default(uuid(7)) @db.Uuid
  /// LD-000001
  leadCode            String     @unique
  fullName            String
  /// normalized 8801XXXXXXXXX
  mobile              String
  altMobile           String?
  email               String?
  location            String?
  profession          String?
  budgetMin           Decimal?   @db.Decimal(14, 2)
  budgetMax           Decimal?   @db.Decimal(14, 2)
  preferredProjectId  String?    @db.Uuid
  propertyType        String?
  sourceId            String     @db.Uuid
  campaignId          String?    @db.Uuid
  /// id at the source (e.g. Facebook lead id), so imports never duplicate
  externalRef         String?    @unique
  status              LeadStatus @default(NEW)
  lostReason          String?
  notes               String?
  nextFollowUpAt      DateTime?  @db.Timestamptz(3)
  lastActivityAt      DateTime?  @db.Timestamptz(3)
  /// another lead for the same person, accepted at creation
  duplicateOfId       String?    @db.Uuid
  convertedCustomerId String?    @db.Uuid
  convertedAt         DateTime?  @db.Timestamptz(3)
  /// data scope: assigned employee, stamped with their org on (re)assignment
  ownerId             String?    @db.Uuid
  teamId              String?    @db.Uuid
  departmentId        String?    @db.Uuid
  branchId            String?    @db.Uuid
  assignedAt          DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  createdById         String?    @db.Uuid
  updatedById         String?    @db.Uuid
  deletedAt           DateTime?  @db.Timestamptz(3)

  source            LeadSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  campaign          Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  preferredProject  Project?       @relation("LeadPreferredProject", fields: [preferredProjectId], references: [id], onDelete: SetNull)
  owner             Employee?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  duplicateOf       Lead?          @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        Lead[]         @relation("LeadDuplicates")
  convertedCustomer Customer?      @relation("LeadConversions", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  activities        LeadActivity[]
  followUps         FollowUp[]
  siteVisits        SiteVisit[]

  @@index([mobile])
  @@index([email])
  @@index([ownerId, status])
  @@index([status, createdAt])
  @@index([nextFollowUpAt])
  @@index([branchId])
}

/// Timeline: calls, notes, status changes, assignments. Never edited.
model LeadActivity {
  id          String           @id @default(uuid(7)) @db.Uuid
  leadId      String           @db.Uuid
  type        LeadActivityType
  body        String?
  fromStatus  LeadStatus?
  toStatus    LeadStatus?
  /// extra details, e.g. { fromOwner, toOwner } for an assignment
  data        Json?
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LeadActivities", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// A planned contact with a lead. The lead's nextFollowUpAt = its earliest PENDING follow-up.
model FollowUp {
  id             String         @id @default(uuid(7)) @db.Uuid
  leadId         String         @db.Uuid
  type           FollowUpType
  dueAt          DateTime       @db.Timestamptz(3)
  /// what to talk about
  purpose        String?
  status         FollowUpStatus @default(PENDING)
  outcome        String?
  doneAt         DateTime?      @db.Timestamptz(3)
  doneById       String?        @db.Uuid
  cancelReason   String?
  reminderSentAt DateTime?      @db.Timestamptz(3)
  /// data scope: the employee who should do it (+ their org), like a lead
  ownerId        String?        @db.Uuid
  teamId         String?        @db.Uuid
  departmentId   String?        @db.Uuid
  branchId       String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  createdById    String?        @db.Uuid
  updatedById    String?        @db.Uuid

  lead   Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner  Employee? @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  doneBy User?     @relation("FollowUpsDone", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([ownerId, status, dueAt])
  @@index([status, dueAt])
}

model SiteVisit {
  id             String             @id @default(uuid(7)) @db.Uuid
  leadId         String             @db.Uuid
  projectId      String             @db.Uuid
  scheduledAt    DateTime           @db.Timestamptz(3)
  transport      SiteVisitTransport @default(OFFICE_CAR)
  pickupPoint    String?
  /// how many people are coming
  visitors       Int                @default(1)
  note           String?
  status         SiteVisitStatus    @default(SCHEDULED)
  visitedAt      DateTime?          @db.Timestamptz(3)
  interest       InterestLevel?
  /// plot codes shown, e.g. "A-5, A-7"
  plotsShown     String?
  feedback       String?
  cancelReason   String?
  reminderSentAt DateTime?          @db.Timestamptz(3)
  /// data scope: the employee going with the visitor (+ their org)
  ownerId        String?            @db.Uuid
  teamId         String?            @db.Uuid
  departmentId   String?            @db.Uuid
  branchId       String?            @db.Uuid
  completedById  String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  createdById    String?            @db.Uuid
  updatedById    String?            @db.Uuid

  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project     Project   @relation("SiteVisitProject", fields: [projectId], references: [id], onDelete: Restrict)
  owner       Employee? @relation("SiteVisitOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedBy User?     @relation("SiteVisitsCompleted", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([ownerId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([projectId, scheduledAt])
}

enum AssignmentPoolType {
  /// the team's active members
  TEAM
  /// a chosen list of employees
  EMPLOYEES
}

/**
 * Hands new unassigned leads to a pool of employees in turn. Conditions left empty match every
 * lead; rules are tried by priority (lowest first) and the first match wins. No match = the lead
 * stays in the pool for manual assignment.
 */
model LeadAssignmentRule {
  id               String             @id @default(uuid(7)) @db.Uuid
  name             String
  priority         Int                @default(100)
  isActive         Boolean            @default(true)
  // Conditions (all that are set must match)
  sourceId         String?            @db.Uuid
  projectId        String?            @db.Uuid
  /// lead.location contains any of these (case-insensitive), e.g. ["Uttara", "Mirpur"]
  locationKeywords String[]           @default([])
  // Who gets the leads
  poolType         AssignmentPoolType
  teamId           String?            @db.Uuid
  employeeIds      String[]           @default([]) @db.Uuid
  /// round-robin position in the pool
  nextIndex        Int                @default(0)
  assignedCount    Int                @default(0)
  lastAssignedAt   DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  createdById      String?            @db.Uuid
  updatedById      String?            @db.Uuid

  source  LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  project Project?    @relation("AssignmentRuleProject", fields: [projectId], references: [id], onDelete: SetNull)
  team    Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([isActive, priority])
}
