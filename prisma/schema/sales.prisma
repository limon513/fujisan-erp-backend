// Sales terms: payment plan templates (down payment, installments, interest, late fee, cancellation).

enum InstallmentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// How a charge is given: a fixed amount in BDT, or a percentage of a base amount.
enum ChargeType {
  FIXED
  PERCENT
}

/**
 * A reusable set of payment terms, chosen at booking. Its values are copied into the booking, so
 * editing a plan never changes bookings already made.
 */
model PaymentPlan {
  id                      String               @id @default(uuid(7)) @db.Uuid
  name                    String
  description             String?
  /// null = offered for every project
  projectId               String?              @db.Uuid
  isActive                Boolean              @default(true)
  /// due at booking: FIXED amount, or PERCENT of the price
  downPaymentType         ChargeType           @default(PERCENT)
  downPaymentValue        Decimal              @db.Decimal(14, 2)
  /// 0 with a 100% down payment = full payment
  installmentCount        Int
  frequency               InstallmentFrequency @default(MONTHLY)
  /// flat yearly rate on the amount left after the down payment (0 = no interest)
  interestRate            Decimal              @default(0) @db.Decimal(5, 2)
  /// days after the due date before a late fee applies
  gracePeriodDays         Int                  @default(0)
  /// once per overdue installment: FIXED amount, or PERCENT of that installment
  lateFeeType             ChargeType           @default(FIXED)
  lateFeeValue            Decimal              @default(0) @db.Decimal(14, 2)
  /// deducted on cancellation: FIXED amount, or PERCENT of the amount paid
  cancellationChargeType  ChargeType           @default(PERCENT)
  cancellationChargeValue Decimal              @default(0) @db.Decimal(14, 2)
  /// charged on an ownership transfer: FIXED amount, or PERCENT of the booking's net price
  transferFeeType         ChargeType           @default(FIXED)
  transferFeeValue        Decimal              @default(0) @db.Decimal(14, 2)
  sortOrder               Int                  @default(100)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)
  createdById             String?              @db.Uuid
  updatedById             String?              @db.Uuid
  deletedAt               DateTime?            @db.Timestamptz(3)

  project  Project?  @relation("ProjectPaymentPlans", fields: [projectId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([projectId, isActive])
}

enum BookingStatus {
  /// submitted; the plot is reserved (BOOKED) until the decision
  PENDING_APPROVAL
  CONFIRMED
  /// deed registered: the plot is SOLD
  REGISTERED
  REJECTED
  CANCELLED
}

enum InstallmentKind {
  DOWN_PAYMENT
  INSTALLMENT
}

enum InstallmentStatus {
  DUE
  PARTIAL
  PAID
  WAIVED
}

/**
 * A customer's booking of a plot under a payment plan. Prices and the plan's terms are copied in
 * at booking, so later price or plan changes never alter it.
 */
model Booking {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// BK-000001
  bookingNo         String        @unique
  plotId            String        @db.Uuid
  projectId         String        @db.Uuid
  customerId        String        @db.Uuid
  leadId            String?       @db.Uuid
  paymentPlanId     String?       @db.Uuid
  bookingDate       DateTime      @db.Date
  /// plot price at booking
  listPrice         Decimal       @db.Decimal(14, 2)
  /// discount the salesperson asked for
  discountRequested Decimal       @default(0) @db.Decimal(14, 2)
  discountReason    String?
  /// discount in force: as asked while pending, as approved once confirmed
  discountAmount    Decimal       @default(0) @db.Decimal(14, 2)
  netPrice          Decimal       @db.Decimal(14, 2)
  interestAmount    Decimal       @default(0) @db.Decimal(14, 2)
  totalPayable      Decimal       @db.Decimal(14, 2)
  planName          String
  /// the payment plan's terms at booking (down payment, installments, interest, late fee, cancellation)
  planTerms         Json
  status            BookingStatus @default(PENDING_APPROVAL)
  approvalRequestId String?       @db.Uuid
  notes             String?
  confirmedAt       DateTime?     @db.Timestamptz(3)
  /// deed registration: the plot is SOLD
  registeredOn      DateTime?     @db.Date
  deedNo            String?
  closedAt          DateTime?     @db.Timestamptz(3)
  closeReason       String?
  /// data scope: the sales executive (+ their org)
  ownerId           String?       @db.Uuid
  teamId            String?       @db.Uuid
  departmentId      String?       @db.Uuid
  branchId          String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  createdById       String?       @db.Uuid
  updatedById       String?       @db.Uuid

  plot          Plot                @relation(fields: [plotId], references: [id], onDelete: Restrict)
  project       Project             @relation("ProjectBookings", fields: [projectId], references: [id], onDelete: Restrict)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead          Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  paymentPlan   PaymentPlan?        @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  owner         Employee?           @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  installments  Installment[]
  payments      Payment[]
  cancellations Cancellation[]
  transfers     OwnershipTransfer[]

  @@index([plotId, status])
  @@index([customerId])
  @@index([ownerId, status])
  @@index([status, bookingDate])
}

/// The booking's payment schedule: the down payment (number 0) and the installments.
model Installment {
  id                  String            @id @default(uuid(7)) @db.Uuid
  bookingId           String            @db.Uuid
  number              Int
  kind                InstallmentKind
  dueDate             DateTime          @db.Date
  amount              Decimal           @db.Decimal(14, 2)
  paidAmount          Decimal           @default(0) @db.Decimal(14, 2)
  lateFee             Decimal           @default(0) @db.Decimal(14, 2)
  status              InstallmentStatus @default(DUE)
  paidAt              DateTime?         @db.Timestamptz(3)
  /// when the late fee was added (once, after due date + grace period)
  lateFeeAppliedAt    DateTime?         @db.Timestamptz(3)
  lateFeeWaivedReason String?
  /// smallest "days before due" reminder already sent (7, 3, 1); 0 = overdue notice sent
  reminderDays        Int?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([bookingId, number])
  @@index([status, dueDate])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  /// entered, waiting for accounts to verify
  PENDING
  /// money received: receipt issued, applied to the schedule
  VERIFIED
  /// entry refused at verification (never counted)
  REJECTED
  /// verified earlier, then undone (e.g. a bounced cheque)
  REVERSED
}

/**
 * Money from a customer against a booking. Entry → verification (money receipt, applied to the
 * installments oldest first) → posting. Never deleted: a mistake or bounced cheque is reversed.
 */
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  /// PAY-000001, at entry
  paymentNo        String        @unique
  /// MR-000001, issued at verification
  receiptNo        String?       @unique
  bookingId        String        @db.Uuid
  customerId       String        @db.Uuid
  amount           Decimal       @db.Decimal(14, 2)
  method           PaymentMethod
  /// transaction id, cheque number, ...
  reference        String?
  bankName         String?
  chequeDate       DateTime?     @db.Date
  /// the day the customer paid
  paidOn           DateTime      @db.Date
  note             String?
  status           PaymentStatus @default(PENDING)
  /// where the money went (cash in hand, a bank or mobile account), chosen at verification
  depositAccountId String?       @db.Uuid
  verifiedById     String?       @db.Uuid
  verifiedAt       DateTime?     @db.Timestamptz(3)
  rejectReason     String?
  reversedById     String?       @db.Uuid
  reversedAt       DateTime?     @db.Timestamptz(3)
  reverseReason    String?
  /// data scope: copied from the booking (its sales executive + org)
  ownerId          String?       @db.Uuid
  teamId           String?       @db.Uuid
  departmentId     String?       @db.Uuid
  branchId         String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  createdById      String?       @db.Uuid

  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  depositAccount Account?            @relation("PaymentDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]

  @@index([bookingId, status])
  @@index([status, paidOn])
  @@index([customerId])
}

/// How a verified payment was applied to installments (undone exactly on reversal).
model PaymentAllocation {
  id            String   @id @default(uuid(7)) @db.Uuid
  paymentId     String   @db.Uuid
  installmentId String   @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  /// part of `amount` that paid the installment's late fee (the amount is paid first)
  lateFeePart   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([installmentId])
}

enum CancellationStatus {
  /// waiting for the CANCELLATION approval; the booking still stands
  PENDING_APPROVAL
  /// booking cancelled, plot released; the refund is still to be paid
  APPROVED
  /// refund paid (or nothing to refund)
  REFUNDED
  REJECTED
  WITHDRAWN
}

/**
 * Cancellation of a confirmed booking: the refund is what was paid minus the plan's cancellation
 * charge (the approver may change it). Approval cancels the booking and frees the plot.
 */
model Cancellation {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// CN-000001
  cancellationNo    String             @unique
  bookingId         String             @db.Uuid
  reason            String
  requestedOn       DateTime           @db.Date
  /// installment money paid (late fees excluded), at request; recomputed at approval
  totalPaid         Decimal            @db.Decimal(14, 2)
  /// as calculated by the policy / as approved
  chargeAmount      Decimal            @db.Decimal(14, 2)
  refundAmount      Decimal            @db.Decimal(14, 2)
  /// the cancellation terms used (from the booking's plan terms)
  policy            Json
  status            CancellationStatus @default(PENDING_APPROVAL)
  approvalRequestId String?            @db.Uuid
  approvedAt        DateTime?          @db.Timestamptz(3)
  closeReason       String?
  // Refund payout
  refundPaidOn      DateTime?          @db.Date
  refundMethod      PaymentMethod?
  refundReference   String?
  refundAccountId   String?            @db.Uuid
  refundedById      String?            @db.Uuid
  refundedAt        DateTime?          @db.Timestamptz(3)
  /// data scope: the booking's sales executive (+ org)
  ownerId           String?            @db.Uuid
  teamId            String?            @db.Uuid
  departmentId      String?            @db.Uuid
  branchId          String?            @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  createdById       String?            @db.Uuid

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refundAccount Account? @relation("CancellationRefundAccount", fields: [refundAccountId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([status, createdAt])
}

enum TransferStatus {
  /// waiting for the OWNERSHIP_TRANSFER approval; the booking stays with the current customer
  PENDING_APPROVAL
  /// approved; the transfer fee is still to be collected
  APPROVED
  /// fee collected (or none): the booking belongs to the new customer
  COMPLETED
  REJECTED
  WITHDRAWN
}

/// Moving a confirmed booking (and the money paid on it) to another customer.
model OwnershipTransfer {
  id                String         @id @default(uuid(7)) @db.Uuid
  /// TR-000001
  transferNo        String         @unique
  bookingId         String         @db.Uuid
  fromCustomerId    String         @db.Uuid
  toCustomerId      String         @db.Uuid
  reason            String
  requestedOn       DateTime       @db.Date
  /// as calculated by the plan terms / as approved
  feeAmount         Decimal        @db.Decimal(14, 2)
  /// the transfer fee terms used (from the booking's plan terms)
  feePolicy         Json
  /// installment money paid so far, moved to the new customer at completion
  amountPaid        Decimal?       @db.Decimal(14, 2)
  status            TransferStatus @default(PENDING_APPROVAL)
  approvalRequestId String?        @db.Uuid
  approvedAt        DateTime?      @db.Timestamptz(3)
  closeReason       String?
  // Completion (fee received)
  completedOn       DateTime?      @db.Date
  feeMethod         PaymentMethod?
  feeReference      String?
  feeAccountId      String?        @db.Uuid
  completedById     String?        @db.Uuid
  completedAt       DateTime?      @db.Timestamptz(3)
  /// data scope: the booking's sales executive (+ org)
  ownerId           String?        @db.Uuid
  teamId            String?        @db.Uuid
  departmentId      String?        @db.Uuid
  branchId          String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  createdById       String?        @db.Uuid

  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  fromCustomer Customer @relation("TransferFrom", fields: [fromCustomerId], references: [id], onDelete: Restrict)
  toCustomer   Customer @relation("TransferTo", fields: [toCustomerId], references: [id], onDelete: Restrict)
  feeAccount   Account? @relation("TransferFeeAccount", fields: [feeAccountId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([status, createdAt])
  @@index([fromCustomerId])
  @@index([toCustomerId])
}
